@@ -36,15 +36,15 @@ function ChoosePlanPage() {
         <div className="flex items-center justify-between gap-3">
           <Logo />
           <Button
+            type="button"
             variant="outline"
-            size="sm"
-            className="gap-1.5"
+            className="h-10 gap-1.5 rounded-full px-5 font-semibold"
             onClick={() => {
               trackPlanSkipped("top");
               navigate({ to: "/dashboard" });
