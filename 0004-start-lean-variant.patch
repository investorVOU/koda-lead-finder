+function LeanSteps() {
+  const steps = [
+    {
+      title: "Find",
+      text: "Pick a city and a type of business. Kodarai lists ones with good reviews and no website.",
+    },
+    {
+      title: "Build",
+      text: "One tap builds a sample website for that business.",
+    },
+    {
+      title: "Send and get paid",
+      text: "Send the owner the link with a ready-made message. If they like it, agree a price.",
+    },
+  ];
+
+  return (
+    <section className="bg-[#f8f7f1]">
+      <div className="mx-auto w-full max-w-[640px] px-5 py-10 sm:px-8">
+        <ol className="space-y-4">
+          {steps.map((step, index) => (
+            <li key={step.title} className="flex gap-3">
+              <span className="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#e4f4e6] text-[13px] font-bold text-[#15854d]">
+                {index + 1}
+              </span>
+              <div>
+                <p className="text-[15px] font-bold text-[#172019]">{step.title}</p>
+                <p className="mt-0.5 text-[14px] leading-6 text-[#4d5a52]">{step.text}</p>
+              </div>
+            </li>
+          ))}
+        </ol>
+      </div>
+    </section>
+  );
+}
+
+// Lean /start: one promise, the first quiz question right under it, one proof,
+// then only the sections that answer a beginner's doubts. The full page stays
+// available at /start?v=full for comparison.
+function LeanIntro({
+  hook,
+  reviews,
+  onStart,
+  onPickExperience,
+}: {
+  hook: string | null;
+  reviews: PublicMarketingReview[];
+  onStart: () => void;
+  onPickExperience: (value: Experience) => void;
+}) {
+  const [showSticky, setShowSticky] = useState(false);
+
+  useEffect(() => {
+    const timer = window.setTimeout(() => {
+      trackViewContent("start_intro");
+    }, 10000);
+    const onScroll = () => setShowSticky(window.scrollY > 520);
+    window.addEventListener("scroll", onScroll, { passive: true });
+    return () => {
+      window.clearTimeout(timer);
+      window.removeEventListener("scroll", onScroll);
+    };
+  }, []);
+
+  return (
+    <main className="overflow-hidden pb-24 lg:pb-0">
+      <section className="mx-auto w-full max-w-[640px] px-5 pb-10 pt-6 sm:px-8">
+        <Brand />
+
+        <div className="mt-7">
+          <HeroHeadline pinned={hook} />
+
+          <p className="mt-4 max-w-[560px] text-[15px] leading-7 text-[#4d5a52] sm:text-[16px]">
+            No coding needed. Kodarai finds businesses with great Google reviews and no website,
+            builds a sample site for each one, and helps you sell it.
+          </p>
+
+          <p className="mt-6 text-[13px] font-bold text-[#172019]">
+            Which one sounds like you? Tap to start.
+          </p>
+
+          <div className="mt-3 space-y-2.5">
+            {EXPERIENCE_OPTIONS.map((option) => (
+              <ChoiceCard
+                key={option.value}
+                title={option.title}
+                description={option.description}
+                icon={option.icon}
+                selected={false}
+                onClick={() => onPickExperience(option.value)}
+              />
+            ))}
+          </div>
+
+          <p className="mt-3 text-[12px] leading-5 text-[#687169]">
+            Takes about 30 seconds · Plans from {FIRST_PACK_PRICE} · Pay with Paystack
+          </p>
+        </div>
+      </section>
+
+      <section className="bg-[#f5f6f0]">
+        <div className="mx-auto w-full max-w-[640px] px-5 py-10 sm:px-8">
+          <h2 className="text-center text-[22px] font-bold leading-[1.1] tracking-[-0.03em] sm:text-[28px]">
+            See it in action
+          </h2>
+          <p className="mt-2 text-center text-[13px] text-[#687169]">
+            Search a city, pick a business with no website, tap Build Website.
+          </p>
+          <div className="mt-5 overflow-hidden rounded-[20px] border border-[#dce2db] bg-white p-2">
+            <video
+              className="w-full rounded-[14px] bg-[#edf0ea]"
+              autoPlay
+              muted
+              loop
+              playsInline
+              preload="metadata"
+              poster={START_FINDER_IMAGE}
+              aria-label="Kodarai Finder showing businesses with no website and a Build Website button"
+            >
+              <source src={START_FINDER_VIDEO} type="video/mp4" />
+            </video>
+            <p className="px-1 pt-2 text-[10px] text-[#687169]">Real Kodarai Finder interface</p>
+          </div>
+        </div>
+      </section>
+
+      <PlainEnglish />
+      <LeanSteps />
+      <StartFaq />
+      <FinalIntroCta reviews={reviews} onStart={onStart} />
+
+      {showSticky && (
+        <div className="fixed inset-x-0 bottom-0 z-40 border-t border-[#e0e5df] bg-white/95 px-4 pb-[calc(env(safe-area-inset-bottom,0px)+12px)] pt-3 backdrop-blur lg:hidden">
+          <button
+            type="button"
+            onClick={onStart}
+            className="flex min-h-[52px] w-full items-center justify-center gap-2 rounded-xl bg-[#079653] px-5 text-[15px] font-semibold text-white active:scale-[0.99]"
+          >
+            Find my first business
+            <ArrowRight className="size-4" />
+          </button>
+        </div>
+      )}
+    </main>
+  );
+}
