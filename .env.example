# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Required at Vite build time (same values as above)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── hCaptcha ──────────────────────────────────────────────────────────────────
# Create a site at https://dashboard.hcaptcha.com
VITE_HCAPTCHA_SITE_KEY=          # Public site key (safe to expose)
HCAPTCHA_SECRET_KEY=             # Secret key — server-side only, never expose

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# https://dashboard.stripe.com/webhooks → your endpoint → Signing secret
# Webhook events to enable: checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Paystack ──────────────────────────────────────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers → Secret Key
PAYSTACK_SECRET_KEY=sk_live_...
# Webhook events to enable: charge.success, subscription.create,
#   subscription.disable, subscription.not_renew

# ── Telnyx (persistent virtual numbers) ──────────────────────────────────────
# https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=KEY...
# Messaging Profile ID — create one at portal.telnyx.com, set webhook to:
# https://yourdomain.com/api/public/webhooks/sms-incoming
TELNYX_MESSAGING_PROFILE_ID=40019ead-...
# Ed25519 public key from portal.telnyx.com → API Keys → Webhook signing key (base64)
TELNYX_WEBHOOK_SECRET=...
TELNYX_WEBHOOK_BASE_URL=https://yourdomain.com

# ── SMSPool (temp / one-time OTP numbers) ─────────────────────────────────────
# https://smspool.net → Account → API key
SMSPOOL_API_KEY=...

# ── App ───────────────────────────────────────────────────────────────────────
# Your deployed URL — used for payment redirect callbacks server-side
APP_URL=https://yourdomain.com
RESEND_API_KEY=
EMAIL_FROM=KodarAI Support <support@updates.yourdomain.com>
# Required to sign one-click unsubscribe links for marketing emails.
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret
# Required by the protected weekly marketing endpoint /api/public/marketing/weekly.
MARKETING_CRON_SECRET=replace-with-a-different-long-random-secret

# Support chat admin - server-side only. This email can access /support.
SUPPORT_ADMIN_EMAIL=your-admin-email@example.com

# Browser push notifications for the support admin.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@kodarai.xyz

# ── AI providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
