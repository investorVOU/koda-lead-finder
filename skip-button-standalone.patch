 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/routes/_authenticated/choose-plan.tsx b/src/routes/_authenticated/choose-plan.tsx
index 3523fb7..701eb92 100644
--- a/src/routes/_authenticated/choose-plan.tsx
+++ b/src/routes/_authenticated/choose-plan.tsx
